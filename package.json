{
  "name": "executive-intelligence-index",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && npm run generate:exports && ASTRO_TELEMETRY_DISABLED=1 astro build && pagefind --site docs && npm run generate:postbuild",
    "lint": "eslint .",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest run",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "check": "npm run lint && npm run typecheck && npm run validate:data && npm run validate:provenance && npm run validate:attributions && npm run validate:statements && npm run validate:propositions && npm run validate:book-editions && npm run validate:source-locators && npm run validate:rights && npm run validate:review-status && npm run validate:publication && npm run validate:pilot-release && npm run validate:content && npm run audit:duplicates && npm run audit:concentration && npm run audit:coverage && npm run audit:links && npm run audit:roles && npm run test && npm run build && npm run test:browser && npm run verify:artifacts",
    "validate:data": "tsx scripts/cli.ts validate data",
    "validate:provenance": "tsx scripts/cli.ts validate provenance",
    "validate:attributions": "tsx scripts/cli.ts validate attributions",
    "validate:statements": "tsx scripts/cli.ts validate statements",
    "validate:propositions": "tsx scripts/cli.ts validate propositions",
    "validate:book-editions": "tsx scripts/cli.ts validate book-editions",
    "validate:source-locators": "tsx scripts/cli.ts validate source-locators",
    "validate:rights": "tsx scripts/cli.ts validate rights",
    "validate:review-status": "tsx scripts/cli.ts validate review-status",
    "validate:publication": "tsx scripts/cli.ts validate publication",
    "validate:content": "tsx scripts/cli.ts validate content",
    "validate:discovery": "tsx scripts/validate-discovery-batch.ts",
    "validate:book-metadata": "tsx scripts/validate-book-metadata-batch.ts",
    "validate:book-analysis": "tsx scripts/validate-book-analysis-batch.ts",
    "validate:pilot-release": "tsx scripts/validate-pilot-release.ts",
    "promote:pilot": "tsx scripts/promote-pilot.ts",
    "audit:duplicates": "tsx scripts/cli.ts audit duplicates",
    "audit:concentration": "tsx scripts/cli.ts audit concentration",
    "audit:coverage": "tsx scripts/cli.ts audit coverage",
    "audit:links": "tsx scripts/audit-links.ts",
    "audit:roles": "tsx scripts/audit-role-freshness.ts",
    "generate:exports": "tsx scripts/cli.ts generate exports",
    "generate:review-packets": "tsx scripts/cli.ts generate review-packets",
    "generate:search-index": "tsx scripts/cli.ts generate search-index",
    "generate:graph": "tsx scripts/cli.ts generate graph",
    "generate:citations": "tsx scripts/cli.ts generate citations",
    "generate:site": "npm run build",
    "generate:release": "tsx scripts/cli.ts generate release",
    "generate:postbuild": "tsx scripts/cli.ts generate postbuild",
    "generate:schemas": "node scripts/generate-schemas.mjs",
    "verify:artifacts": "tsx scripts/cli.ts verify artifacts",
    "verify:live": "tsx scripts/verify-live.ts",
    "scaffold:batch": "tsx scripts/scaffold.ts batch",
    "scaffold:protocol": "tsx scripts/scaffold.ts protocol",
    "scaffold:record": "tsx scripts/scaffold.ts record",
    "scaffold:source": "tsx scripts/scaffold.ts source",
    "scaffold:book": "tsx scripts/scaffold.ts book",
    "scaffold:statement": "tsx scripts/scaffold.ts statement",
    "scaffold:proposition": "tsx scripts/scaffold.ts proposition",
    "report:rights": "tsx scripts/cli.ts report rights",
    "report:release-readiness": "tsx scripts/cli.ts report release-readiness",
    "calculate:trends": "tsx scripts/cli.ts calculate trends",
    "verify:determinism": "tsx scripts/verify-determinism.ts",
    "sync:external": "tsx scripts/cli.ts sync external"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.2.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "9.34.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.3.0",
    "eslint": "10.8.1",
    "pagefind": "1.5.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "4.1.10"
  }
}
