  "candidates": [
    {
      "proposition_candidate_id": "proposition-candidate-BATCH-2026-006-001",
      "neutral_text": "Agents should have stable identities distinct from the principals they represent.",
      "status": "candidate_only_not_a_canonical_proposition",
      "human_review_status": "pending"
    },
    {
      "proposition_candidate_id": "proposition-candidate-BATCH-2026-006-002",
      "neutral_text": "Delegated authority should preserve both principal and agent context.",
      "status": "candidate_only_not_a_canonical_proposition",
      "human_review_status": "pending"
    },
    {
      "proposition_candidate_id": "proposition-candidate-BATCH-2026-006-003",
      "neutral_text": "Agent permissions should be bounded by least privilege and attenuated across delegation.",
      "status": "candidate_only_not_a_canonical_proposition",
      "human_review_status": "pending"
    },
    {
      "proposition_candidate_id": "proposition-candidate-BATCH-2026-006-004",
      "neutral_text": "Agent identity governance should include provisioning, rotation, revocation, and de-provisioning.",
      "status": "candidate_only_not_a_canonical_proposition",
      "human_review_status": "pending"
    },
    {
      "proposition_candidate_id": "proposition-candidate-BATCH-2026-006-005",
      "neutral_text": "Auditability depends on traceable identity and authorization context.",
      "status": "candidate_only_not_a_canonical_proposition",
      "human_review_status": "pending"
    },
    {
      "proposition_candidate_id": "proposition-candidate-BATCH-2026-006-006",
      "neutral_text": "Agent systems need layered evaluation, authorization controls, and monitoring.",
      "status": "candidate_only_not_a_canonical_proposition",
      "human_review_status": "pending"
    },
    {
      "proposition_candidate_id": "proposition-candidate-BATCH-2026-006-007",
      "neutral_text": "Users and deployers need reliable mechanisms to interrupt agents and their subagents.",
      "status": "candidate_only_not_a_canonical_proposition",
      "human_review_status": "pending"
    },
    {
      "proposition_candidate_id": "proposition-candidate-BATCH-2026-006-008",
      "neutral_text": "Synthetic security benchmarks demonstrate capabilities but do not estimate production prevalence.",
      "status": "candidate_only_not_a_canonical_proposition",
      "human_review_status": "pending"
    },
    {
      "proposition_candidate_id": "proposition-candidate-BATCH-2026-006-009",
      "neutral_text": "Multi-agent coordination can increase cybersecurity capability and associated governance risk.",
      "status": "candidate_only_not_a_canonical_proposition",
      "human_review_status": "pending"
    }
